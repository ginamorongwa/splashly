{
  "name": "splashly",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "mobile": "npm run start --workspace @splashly/mobile",
    "web": "npm run dev --workspace @splashly/web",
    "test": "npm run test --workspace @splashly/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
